{
  "schemaVersion": 1,
  "id": "talkingskin",
  "version": "${version}",
  "name": "Talking Skin",
  "description": "Thick cartoon lips with teeth and subtle body/head/arm movement on player models while they talk in Simple Voice Chat.",
  "authors": ["DEIN NAME"],
  "contact": {},
  "license": "MIT",
  "icon": "assets/talkingskin/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.talkingskin.TalkingSkinClient"],
    "voicechat": ["dev.talkingskin.TalkingSkinVoicechatPlugin"]
  },
  "mixins": ["talkingskin.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "recommends": {
    "voicechat": "*"
  }
}
